{
  "name": "cobble-workspace",
  "displayName": "Cobble Workspace",
  "version": "0.1.0",
  "publisher": "cobble-local",
  "license": "UNLICENSED",
  "description": "Pair a saved-file workspace with your local Cobble app",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cobble.pair",
        "title": "Cobble: Pair Workspace"
      },
      {
        "command": "cobble.disconnect",
        "title": "Cobble: Disconnect"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  }
}
