{
  "name": "cobble",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Cobble",
  "description": "A local-first companion for teams building together",
  "type": "module",
  "main": "dist/main/main.cjs",
  "bin": {
    "cobble": "dist/cli.cjs"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts test extensions/vscode/src",
    "test": "tsx --test test/*.test.ts",
    "test:desktop": "node scripts/smoke.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:voice": "tsx scripts/test-voice.ts",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "bundle:extension": "node scripts/package-extension.mjs",
    "dist:win": "npm run prepare:runtime && npm run verify:runtime && npm run build && npm run bundle:extension && electron-builder --win nsis --x64 --publish never",
    "check": "npm run typecheck && npm test && npm run build",
    "build:extension": "esbuild extensions/vscode/src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=extensions/vscode/dist/extension.cjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chokidar": "^4.0.3",
    "diff": "^9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "vite": "^7.0.0"
  }
}
