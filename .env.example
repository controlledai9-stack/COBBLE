# Copy to backend/.env (or repo-root .env). Never commit real values.

# auto = Firestore when FIREBASE_CREDENTIALS is set, else SQLite. Also: sqlite | firestore | memory
SWARMGUARD_STORAGE=auto
# Shared workspace all five teammates read/write (Firestore: workspaces/{workspace}/...)
SWARMGUARD_WORKSPACE=default
# SQLite fallback location (default: backend/data/swarmguard.db)
# SWARMGUARD_SQLITE_PATH=

# Firestore (server-side only; the browser never sees these)
# FIREBASE_CREDENTIALS=C:/path/to/service-account.json
# FIREBASE_PROJECT_ID=your-project-id

# Google Gemini API (Member 1 - Agent Simulator)
# GEMINI_API_KEY=
# Free tier: 2.5 Flash allows only 5 requests/min; 3.5 Flash-Lite is fast with a much higher limit.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Anthropic Claude API (alternative provider)
# ANTHROPIC_API_KEY=
SWARMGUARD_LLM_MODEL=claude-haiku-5-5

# Agent-written code runs in a sandbox during user-task runs (on by default). Set to off to never run it.
# SWARMGUARD_CODE_EXEC=off

# Hard cap on model calls per simulation run (spending limit)
SWARMGUARD_LLM_MAX_CALLS=80

SWARMGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Active-response implementation is opt-in. Protected simulations mediate local
# virtual tools and broker effects. Candidate code remains held in the simulator;
# the isolated validator is a separate controlled service, pending API integration.
# off | monitor | enforce (server-owned profile, not an agent-selectable setting)
SWARMGUARD_RESPONSE_MODE=off
# A separate random operator credential, at least 32 characters. Never give it to agents.
# SWARMGUARD_RESPONSE_OPERATOR_TOKEN=
SWARMGUARD_RESPONSE_MINIMUM_GATEWAY=monitor
